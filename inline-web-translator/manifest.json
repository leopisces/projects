{
  "manifest_version": 3,
  "name": "Inline Web Translator",
  "version": "1.14.2",
  "description": "自动识别网页中的外语句子，逐句翻译为中文并显示在每句原文下方，适合学习与查阅资料。",
  "permissions": ["storage", "declarativeNetRequest"],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://translate-pa.googleapis.com/*",
    "https://translate.google.com/*",
    "https://api.deepseek.com/*",
    "https://ark.cn-beijing.volces.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["early.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Inline Web Translator",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
