# ---- 依赖 ----
node_modules/

# ---- 构建产物 ----
# dist/ 由 vite build 生成，发布时现场构建即可，不入库
dist/
.vite/

# ---- Android 打包产物（android/.gitignore 已覆盖大部分）----
apk/
*.apk
*.aab
build.log
build.err.log

# ---- 日志 ----
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ---- 本地私有配置（含 API Key，绝不入库）----
# src/config.local.js 由本地创建，dev/build 时内联进产物：
#   export default { apiBase: '/llm-proxy/v1', apiKey: 'sk-...', model: 'deepseek-chat' }
# 一旦 build，Key 会出现在 dist/ 的 js 里 —— dist 不入库，也不要公开部署到公网。
src/config.local.js
*.local.js

# ---- 环境变量 ----
.env
.env.*
!.env.example

# ---- 编辑器 / IDE ----
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# ---- 操作系统 ----
.DS_Store
Thumbs.db
Desktop.ini

# ---- 临时文件 ----
*.tmp
*.temp
.cache/
coverage/
temp/

# 注意：public/rulebook.md 是 AI 评分规则的唯一事实来源，属于源码，必须入库。
# 不要加 *.md 之类的通配忽略规则。

# 诊断日志
tools/diag.log
tools/server.out
